<% layout("/layouts/boilerplate") %>

        <div id="filters">
        <div class="filter <%= category === 'Trending' ? 'active' : '' %>">
            <a href="/listings?category=Trending" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-fire"></i>
                    <p>Trending</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Rooms' ? 'active' : '' %>">
            <a href="/listings?category=Rooms" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-bed"></i>
                    <p>Rooms</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Iconic cities' ? 'active' : '' %>">
            <a href="/listings?category=Iconic cities" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-city"></i>
                    <p>Iconic cities</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Mountains' ? 'active' : '' %>">
            <a href="/listings?category=Mountains" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-person-hiking"></i>
                    <p>Mountains</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Camping' ? 'active' : '' %>">
            <a href="/listings?category=Camping" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-campground"></i>
                    <p>Camping</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Castles' ? 'active' : '' %>">
            <a href="/listings?category=Castles" class="text-decoration-none text-reset">
                <div><i class="fa-brands fa-fort-awesome"></i>
                    <p>Castles</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Amazing pools' ? 'active' : '' %>">
            <a href="/listings?category=Amazing pools" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-fish"></i>
                    <p>Amazing pools</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Arctic' ? 'active' : '' %>">
            <a href="/listings?category=Arctic" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-snowflake"></i>
                    <p>Arctic</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Hidden gems' ? 'active' : '' %>">
            <a href="/listings?category=Hidden gems" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-gem"></i>
                    <p>Hidden gems</p>
                </div>
            </a>
        </div>
        <div class="filter <%= category === 'Nightlife' ? 'active' : '' %>">
            <a href="/listings?category=Nightlife" class="text-decoration-none text-reset">
                <div><i class="fa-solid fa-cloud-moon"></i>
                    <p>Nightlife</p>
                </div>
            </a>
        </div>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>

    <% if (allListings.length === 0) { %>
        <div class="text-center my-5">
            <h4>Nothing matched your search</h4>
            <a href="/listings" class="btn btn-accent mt-3">Show all stays</a>
        </div>
    <% } %>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 ">
        <% for (let listing of allListings) { %>
            <div class="card col listing-card">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none">
                    <img src="<%= listing.image?.url || '/images/default.jpg' %>" class="card-img-top listing-img"
                        alt="<%= listing.title || 'Default Listing' %>">

                    <div class="card-img-overlay"></div>

                    <div class="card-body">
                        <p class="card-text">
                            <strong>
                                <%= listing.title || 'Untitled Listing' %>
                            </strong><br>
                            <% if (listing.location) { %>
                                <span class="text-muted"><%= listing.location %><%= listing.country ? ", " + listing.country : "" %></span><br>
                            <% } %>
                            &#8377; <%= listing.price?.toLocaleString("en-IN") || 'N/A' %> /night
                            <i class="tax-info"> &nbsp; +18% GST </i>
                        </p>
                    </div>
                </a>
            </div>
        <% } %>
    </div>


    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo) {
            if(info.style.display != "inline"){
            info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
    </script>