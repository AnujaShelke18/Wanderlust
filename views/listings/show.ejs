<% layout("layouts/boilerplate") %>

  <script>
    const mapToken = "<%= mapToken %>";
    const listing = <% - JSON.stringify({ title: listing.title, geometry: listing.geometry }).replace(/</g, '\\u003c') %>;
  </script>

  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>
        <%= listing.title %>
      </h3>
    </div>

    <div class="card col-8 offset-2 mb-3 listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing Image">
      <div class="card-body">
        <p class="card-text"><b>@<%= listing.owner ? listing.owner.username : "unknown" %></b></p>
        <p class="card-text">
          <%= listing.description %>
        </p>
        <p class="card-text"><strong>Price:</strong> ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A'
            %>
        </p>
        <p class="card-text"><strong>Location:</strong>
          <%= listing.location %>
        </p>
        <p class="card-text"><strong>Country:</strong>
          <%= listing.country %>
        </p>
      </div>
    </div>

    <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
      <div class="col-12 col-md-8 offset-md-2 d-grid gap-2 d-sm-flex mb-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn2">Edit this Listing</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-grid">
          <button class="btn delete-btn">Delete this Listing</button>
        </form>
      </div>
      <% } %>

        <!-- Review form -->
        <% if (currUser) { %>
          <div class="col-8 offset-2 mt-4">
            <div class="review-card">
              <h4 class="mb-3">Leave a review</h4>
              <form action="/listings/<%= listing._id %>/reviews" method="POST">
                <fieldset class="starability-slot">
                  <legend>Rating</legend>
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                    aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>

                <div class="mb-3">
                  <label for="comment" class="form-label">Comment</label>
                  <textarea id="comment" name="review[comment]" rows="4" class="form-control"
                    placeholder="Share your experience" required></textarea>
                </div>
                <button type="submit" class="btn btn-accent">Submit review</button>
              </form>
            </div>
          </div>
          <% } %>

            <!-- Review list -->
            <% if (listing.reviews && listing.reviews.length> 0) { %>
              <div class="col-8 offset-2 mt-4">
                <h4 class="mb-3">All reviews</h4>
                <div class="row g-3">
                  <% for (let review of listing.reviews) { %>
                    <div class="col-md-6">
                      <div class="review-card h-100">
                        <h6 class="mb-1">@<%= review.author ? review.author.username : "unknown" %>
                        </h6>
                        <p class="starability-result" data-rating="<%= review.rating %>">
                          Rated: <%= review.rating %> stars
                        </p>
                        <p class="mb-0">
                          <%= review.comment %>
                        </p>
                        <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                          <form method="POST"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-2">
                            <button class="btn btn-sm delete-btn">Delete</button>
                            <a href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit"
                              class="btn btn-sm edit-btn2">Edit</a>
                          </form>
                          <% } %>
                      </div>
                    </div>
                    <% } %>
                </div>
              </div>
              <% } %>

                <!-- Map -->
                <div class="col-8 offset-2 mt-4 mb-4">
                  <h3>Where you'll be</h3>
                  <div id="map"></div>
                </div>
  </div>

  <script src="/js/map.js"></script>