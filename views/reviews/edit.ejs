<% layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <div class="review-card">
      <h4 class="mb-3">Edit your review</h4>
      <form action="/listings/<%= listingId %>/reviews/<%= review._id %>?_method=PUT" method="POST">
        <fieldset class="starability-slot">
          <legend>Rating</legend>
          <input type="radio" id="edit-rate1" name="review[rating]" value="1" <%= review.rating === 1 ? "checked" : "" %> />
          <label for="edit-rate1" title="Terrible">1 star</label>
          <input type="radio" id="edit-rate2" name="review[rating]" value="2" <%= review.rating === 2 ? "checked" : "" %> />
          <label for="edit-rate2" title="Not good">2 stars</label>
          <input type="radio" id="edit-rate3" name="review[rating]" value="3" <%= review.rating === 3 ? "checked" : "" %> />
          <label for="edit-rate3" title="Average">3 stars</label>
          <input type="radio" id="edit-rate4" name="review[rating]" value="4" <%= review.rating === 4 ? "checked" : "" %> />
          <label for="edit-rate4" title="Very good">4 stars</label>
          <input type="radio" id="edit-rate5" name="review[rating]" value="5" <%= review.rating === 5 ? "checked" : "" %> />
          <label for="edit-rate5" title="Amazing">5 stars</label>
        </fieldset>

        <div class="mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea id="comment" name="review[comment]" rows="4" class="form-control" required><%= review.comment %></textarea>
        </div>

        <button type="submit" class="btn btn-accent">Save changes</button>
        <a href="/listings/<%= listingId %>" class="btn btn-outline-secondary">Cancel</a>
      </form>
    </div>
  </div>
</div>